// prisma/schema.prisma\ngenerator client {\n  provider = "prisma-client-js"\n}\n\ndatasource db {\n  provider = "postgresql"\n  url      = env("DATABASE_URL")\n}\n\nmodel User {\n  id            String     @id @default(cuid())\n  email         String     @unique\n  name          String\n  password      String\n  avatar        String?\n  role          String     @default("staff") // admin, manager, staff, donor\n  isActive      Boolean    @default(true)\n  lastLogin     DateTime?\n  createdAt     DateTime   @default(now())\n  updatedAt     DateTime   @updatedAt\n\n  projects      Project[]  @relation("ProjectManager")\n  tasks         Task[]     @relation("TaskAssignee")\n  messages      Message[]  @relation("MessageSender")\n  activities    Activity[]\n  notifications Notification[]\n  payments      Payment[]  @relation("PaymentUser")\n  auditLogs     AuditLog[]\n}\n\nmodel Project {\n  id            String     @id @default(cuid())\n  name          String\n  description   String?\n  status        String     @default("planning") // planning, active, completed, delayed\n  startDate     DateTime\n  endDate       DateTime\n  budget        Float\n  spent         Float      @default(0)\n  progress      Int        @default(0)\n  location      String?\n  donor         String?\n  managerId     String\n  manager       User       @relation("ProjectManager", fields: [managerId], references: [id])\n  createdAt     DateTime   @default(now())\n  updatedAt     DateTime   @updatedAt\n\n  tasks         Task[]\n  beneficiaries BeneficiaryProject[]\n  documents     Document[]\n  budgets       Budget[]\n  activities    Activity[]\n}\n\nmodel Task {\n  id            String     @id @default(cuid())\n  title         String\n  description   String?\n  status        String     @default("todo") // todo, in_progress, completed\n  priority      String     @default("medium") // low, medium, high\n  dueDate       DateTime?\n  projectId     String\n  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  assigneeId    String?\n  assignee      User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])\n  createdAt     DateTime   @default(now())\n  updatedAt     DateTime   @updatedAt\n\n  activities    Activity[]\n}\n\nmodel Beneficiary {\n  id            String     @id @default(cuid())\n  name          String\n  email         String?\n  phone         String?\n  category      String? // children, women, families, community_members\n  status        String     @default("active") // active, follow-up, inactive\n  enrolledDate  DateTime   @default(now())\n  region        String?\n  notes         String?\n  createdAt     DateTime   @default(now())\n  updatedAt     DateTime   @updatedAt\n\n  projects      BeneficiaryProject[]\n}\n\nmodel BeneficiaryProject {\n  id            String     @id @default(cuid())\n  beneficiaryId String\n  projectId     String\n  enrolledDate  DateTime   @default(now())\n\n  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)\n  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@unique([beneficiaryId, projectId])\n}\n\nmodel Budget {\n  id            String     @id @default(cuid())\n  projectId     String\n  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  category      String     // personnel, equipment, travel, admin\n  allocated     Float\n  spent         Float      @default(0)\n  createdAt     DateTime   @default(now())\n  updatedAt     DateTime   @updatedAt\n}\n\nmodel Document {\n  id            String     @id @default(cuid())\n  projectId     String\n  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  name          String\n  url           String\n  type          String? // proposal, report, contract\n  uploadedAt    DateTime   @default(now())\n}\n\nmodel Message {\n  id            String     @id @default(cuid())\n  content       String\n  encrypted     String? // for end-to-end encryption\n  senderId      String\n  sender        User       @relation("MessageSender", fields: [senderId], references: [id])\n  recipientId   String?\n  groupId       String?\n  isRead        Boolean    @default(false)\n  createdAt     DateTime   @default(now())\n}\n\nmodel Activity {\n  id            String     @id @default(cuid())\n  action        String     // created, updated, completed, deleted\n  entity        String     // project, task, budget, document\n  entityId      String\n  description   String?\n  userId        String\n  user          User       @relation(fields: [userId], references: [id])\n  projectId     String?\n  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)\n  taskId        String?\n  task          Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)\n  createdAt     DateTime   @default(now())\n}\n\nmodel Notification {\n  id            String     @id @default(cuid())\n  userId        String\n  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  title         String\n  message       String\n  type          String? // info, warning, success, error\n  isRead        Boolean    @default(false)\n  createdAt     DateTime   @default(now())\n}\n\nmodel Payment {\n  id            String     @id @default(cuid())\n  userId        String\n  user          User       @relation("PaymentUser", fields: [userId], references: [id])\n  amount        Float\n  currency      String     @default("ETB")\n  method        String     // chapa, paypal\n  status        String     @default("pending") // pending, completed, failed\n  transactionId String?\n  createdAt     DateTime   @default(now())\n  updatedAt     DateTime   @updatedAt\n}\n\nmodel AuditLog {\n  id            String     @id @default(cuid())\n  userId        String\n  user          User       @relation(fields: [userId], references: [id])\n  action        String\n  resource      String\n  details       String?\n  ipAddress     String?\n  createdAt     DateTime   @default(now())\n}\n